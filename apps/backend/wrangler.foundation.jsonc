{
  "$schema": "../../config/workers/node_modules/wrangler/config-schema.json",
  "name": "wodge-foundation-local",
  "main": "tests/foundation/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wodge-foundation-local",
      "database_id": "00000000-0000-0000-0000-000000000218",
      "migrations_dir": "../../packages/data/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FOUNDATION_ROOMS", "class_name": "FoundationRoom" },
      { "name": "FOUNDATION_PAGES", "class_name": "FoundationPage" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FoundationRoom", "FoundationPage"] },
  ],
}
